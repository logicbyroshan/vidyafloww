# Digital E-Library & Reading Hub (डिजिटल ई-पुस्तकालय व अध्ययन केंद्र) — Environment Configuration
# Subdomain: https://library.vidyafloww.com
PORT=8014
VITE_APP_NAME="Digital E-Library & Reading Hub"
VITE_SUBDOMAIN="https://library.vidyafloww.com"
VITE_MAIN_PORTAL_URL="http://localhost:3000"
VITE_API_BASE_URL="http://localhost:8114/api/v1"
VITE_ENABLE_MOCK_DATA=true

# Standalone Microservice Backend Settings
BACKEND_PORT=8114
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/library_management_db"
REDIS_URL="redis://localhost:6379/1"
JWT_SECRET_KEY="REPLACE_WITH_SECURE_GENERATED_SECRET_IN_PRODUCTION"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8014,https://library.vidyafloww.com,https://app.vidyafloww.com"
