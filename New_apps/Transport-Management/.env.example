# Fleet & Transport Management (परिवहन व वाहन बेड़ा प्रबंधन) — Environment Configuration
# Subdomain: https://transport.vidyafloww.com
PORT=8012
VITE_APP_NAME="Fleet & Transport Management"
VITE_SUBDOMAIN="https://transport.vidyafloww.com"
VITE_MAIN_PORTAL_URL="http://localhost:3000"
VITE_API_BASE_URL="http://localhost:8112/api/v1"
VITE_ENABLE_MOCK_DATA=true

# Standalone Microservice Backend Settings
BACKEND_PORT=8112
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/transport_management_db"
REDIS_URL="redis://localhost:6379/1"
JWT_SECRET_KEY="REPLACE_WITH_SECURE_GENERATED_SECRET_IN_PRODUCTION"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8012,https://transport.vidyafloww.com,https://app.vidyafloww.com"
