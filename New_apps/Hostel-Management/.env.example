# Hostel & Dormitory Management (छात्रावास व शयन कक्ष प्रबंधन) — Environment Configuration
# Subdomain: https://hostel.vidyafloww.com
PORT=8011
VITE_APP_NAME="Hostel & Dormitory Management"
VITE_SUBDOMAIN="https://hostel.vidyafloww.com"
VITE_MAIN_PORTAL_URL="http://localhost:3000"
VITE_API_BASE_URL="http://localhost:8111/api/v1"
VITE_ENABLE_MOCK_DATA=true

# Standalone Microservice Backend Settings
BACKEND_PORT=8111
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hostel_management_db"
REDIS_URL="redis://localhost:6379/1"
JWT_SECRET_KEY="REPLACE_WITH_SECURE_GENERATED_SECRET_IN_PRODUCTION"
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8011,https://hostel.vidyafloww.com,https://app.vidyafloww.com"
